{
  "name": "n8n-nodes-osrmroute",
  "version": "0.1.0",
  "description": "OSRMRoute location APIs for n8n: routing, geocoding, places, road data and map studio",
  "license": "MIT",
  "homepage": "https://osrmroute.com/docs/automation",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "OSRMRoute",
    "email": "support@osrmroute.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mammadoff/osrmroute-integrations.git",
    "directory": "n8n-nodes-osrmroute"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test tests/*.test.cjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/OsrmrouteApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Osrmroute/Osrmroute.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.53.1",
    "eslint": "9.32.0",
    "n8n-core": "2.16.1",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
